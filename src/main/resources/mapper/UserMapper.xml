<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE mapper PUBLIC '-//mybatis.org//DTD Mapper 3.0//EN' 'https://mybatis.org/dtd/mybatis-3-mapper.dtd'>
<mapper namespace='com.cs.cs_hotpot_ordering_system.mapper.UserMapper'>
    <!-- 根据登录账号查询用户。 -->
    <select id='findByUsername' resultType='com.cs.cs_hotpot_ordering_system.entity.User'>
        SELECT *
        FROM `user`
        WHERE username = #{username}
        LIMIT 1
    </select>
    <!-- 根据用户主键查询用户。 -->
    <select id='findById' resultType='com.cs.cs_hotpot_ordering_system.entity.User'>
        SELECT *
        FROM `user`
        WHERE id = #{id}
    </select>
    <!-- 查询用户列表。 -->
    <select id='findAll' resultType='com.cs.cs_hotpot_ordering_system.entity.User'>
        SELECT *
        FROM `user`
        ORDER BY createdAt DESC
    </select>
    <!-- 启用或禁用用户。 -->
    <update id='updateStatus'>
        UPDATE `user`
        SET status = #{status}
        WHERE id = #{id}
    </update>
    <!-- 修改用户个人资料。 -->
    <update id='updateProfile'>
        UPDATE `user`
        SET nickname = #{nickname},
            phone = #{phone},
            avatar = #{avatar}
        WHERE id = #{id}
    </update>
    <!-- 修改密码；示例毕设项目按现有明文密码方式保存。 -->
    <update id='updatePassword'>
        UPDATE `user`
        SET password = #{password}
        WHERE id = #{id}
    </update>
</mapper>
